# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=weather-data

# API
API_HOST=0.0.0.0
API_PORT=8000

# Data
DATA_DIR=./data
SCHEMA_VERSION=1.0
