# Database
DATABASE_URL=postgresql+asyncpg://weather:weather@localhost:5432/weatherdb
DATABASE_URL_SYNC=postgresql://weather:weather@localhost:5432/weatherdb

# Redis
REDIS_URL=redis://localhost:6379/0

# Redpanda
